{
  "name": "flashcards-client",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "vitest run -v --silent",
    "coverage": "vitest run --coverage.enabled --silent",
    "sonar": "npx sonar-scanner -Dsonar.token=$npm_config_sonartoken"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "axios": "^1.7.3",
    "dotenv": "^16.4.5",
    "roboto-fontface": "*",
    "vue": "^3.4.37",
    "vue-router": "^4.4.3",
    "vuetify": "3.6.14"
  },
  "devDependencies": {
    "@babel/types": "^7.25.2",
    "@types/css-mediaquery": "^0.1.4",
    "@types/node": "^22.2.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/coverage-v8": "^2.0.5",
    "@vue/test-utils": "^2.4.6",
    "css-mediaquery": "^0.1.2",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^9.27.0",
    "flush-promises": "^1.0.2",
    "jsdom": "^24.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.77.8",
    "sonar-scanner": "^3.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "unplugin-fonts": "^1.1.1",
    "vite": "^5.4.0",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29",
    "vue-eslint-parser": "^9.4.3"
